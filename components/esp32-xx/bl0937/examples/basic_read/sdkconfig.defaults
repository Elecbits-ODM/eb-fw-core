# Example configuration for an ESP32-C3 smart plug board.
# Replace the GPIOs and the electrical parameters with your own hardware values.

CONFIG_BL0937_ENABLE=y
CONFIG_BL0937_CF_GPIO=19
CONFIG_BL0937_CF1_GPIO=6
CONFIG_BL0937_SEL_GPIO=4

CONFIG_BL0937_SHUNT_UOHM=1000
CONFIG_BL0937_V_DIV_RATIO="0.00204"
CONFIG_BL0937_VREF_V="1.218"
CONFIG_BL0937_SAMPLE_PERIOD_MS=1000
CONFIG_BL0937_SEL_SETTLE_US=200
CONFIG_BL0937_GLITCH_FILTER_NS=10000

# Start at 1.0 and adjust after comparing against a reference meter.
CONFIG_BL0937_VOLTAGE_CAL="1.0"
CONFIG_BL0937_CURRENT_CAL="1.0"
CONFIG_BL0937_POWER_CAL="1.0"
